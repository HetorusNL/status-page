{
  "name": "status-page",
  "version": "0.3.5",
  "private": true,
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^5.1.2"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node generate-build-version",
    "build": "npm run prebuild && vite build",
    "generate-build-version": "node generate-build-version",
    "release-patch": "vite version patch && vite postversion",
    "release-minor": "vite version minor && vite postversion",
    "release-major": "vite version major && vite postversion",
    "postversion": "vite build && npm run git-script",
    "git-script": "node git-script",
    "deploy": "./deploy.sh"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.1"
  }
}
